rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // دفتر المعلمات السحابي المبسط (صفحة dafter-cloud)
    match /preps/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // دفتر التحضير اليومي بتصميم سمة (الصفحة الرئيسية)
    // لكل معلمة مساحتها الخاصة ولا ترى غيرها
    match /data/users/{uid}/{path=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
